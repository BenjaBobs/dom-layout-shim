{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "box-model-spacing",
  "title": "Margin, padding, border geometry, and gaps",
  "subjects": {
    "properties": [
      "margin",
      "margin-inline",
      "margin-block",
      "margin-inline-start",
      "margin-inline-end",
      "margin-block-start",
      "margin-block-end",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "padding",
      "padding-inline",
      "padding-block",
      "padding-inline-start",
      "padding-inline-end",
      "padding-block-start",
      "padding-block-end",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "gap",
      "row-gap",
      "column-gap",
      "border",
      "border-top",
      "border-right",
      "border-bottom",
      "border-left",
      "border-width",
      "border-inline-width",
      "border-block-width",
      "border-inline-start-width",
      "border-inline-end-width",
      "border-block-start-width",
      "border-block-end-width",
      "border-top-width",
      "border-right-width",
      "border-bottom-width",
      "border-left-width",
      "border-style",
      "border-inline-style",
      "border-block-style",
      "border-inline-start-style",
      "border-inline-end-style",
      "border-block-start-style",
      "border-block-end-style",
      "border-top-style",
      "border-right-style",
      "border-bottom-style",
      "border-left-style"
    ],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "margins",
      "description": "Physical and logical margins participate in normal flow and supported auto-margin behavior.",
      "properties": [
        "margin",
        "margin-inline",
        "margin-block",
        "margin-inline-start",
        "margin-inline-end",
        "margin-block-start",
        "margin-block-end",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left"
      ],
      "syntax": [
        "<px>",
        "<percentage>",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "logical-properties",
          "static-margin-flow"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Margin collapse is not implemented."
        },
        {
          "kind": "limitation",
          "text": "Length support is limited to pixels, percentages, `auto`, reset keywords, and literal zero."
        },
        {
          "kind": "implementation-quirk",
          "text": "Logical margins are mapped as `horizontal-tb` LTR; non-default `direction` and `writing-mode` are not modeled."
        }
      ]
    },
    {
      "id": "padding",
      "description": "Physical and logical padding contributes to box geometry.",
      "properties": [
        "padding",
        "padding-inline",
        "padding-block",
        "padding-inline-start",
        "padding-inline-end",
        "padding-block-start",
        "padding-block-end",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left"
      ],
      "syntax": [
        "<px>"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "border-box-padding-border",
          "content-box-padding-border",
          "logical-properties",
          "static-parent-padding-border"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Percentage padding and general CSS length units are not implemented."
        },
        {
          "kind": "implementation-quirk",
          "text": "Logical padding is mapped as `horizontal-tb` LTR."
        }
      ]
    },
    {
      "id": "layout-gaps",
      "description": "Row and column gaps separate supported flex and grid tracks.",
      "properties": [
        "gap",
        "row-gap",
        "column-gap"
      ],
      "syntax": [
        "<px>",
        "<percentage>",
        "normal"
      ],
      "conditions": [
        "Percentage gaps require a definite container size on the corresponding axis."
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "flex-gap",
          "grid-gap"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "General CSS length units are not implemented."
        }
      ]
    },
    {
      "id": "border-geometry",
      "description": "Supported border widths and styles contribute to box geometry without painting borders.",
      "properties": [
        "border",
        "border-top",
        "border-right",
        "border-bottom",
        "border-left",
        "border-width",
        "border-inline-width",
        "border-block-width",
        "border-inline-start-width",
        "border-inline-end-width",
        "border-block-start-width",
        "border-block-end-width",
        "border-top-width",
        "border-right-width",
        "border-bottom-width",
        "border-left-width",
        "border-style",
        "border-inline-style",
        "border-block-style",
        "border-inline-start-style",
        "border-inline-end-style",
        "border-block-start-style",
        "border-block-end-style",
        "border-top-style",
        "border-right-style",
        "border-bottom-style",
        "border-left-style"
      ],
      "syntax": [
        "<px>",
        "thin",
        "medium",
        "thick",
        "none",
        "hidden",
        "dotted",
        "dashed",
        "solid",
        "double",
        "groove",
        "ridge",
        "inset",
        "outset"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "border-shorthand",
          "border-width-keywords",
          "border-width-none-style",
          "logical-properties"
        ]
      },
      "notes": [
        {
          "kind": "implementation-quirk",
          "text": "Border widths affect geometry for supported line styles except `none` and `hidden`; border painting is not modeled."
        },
        {
          "kind": "limitation",
          "text": "Border widths are limited to pixels, listed keywords, reset keywords, and literal zero."
        },
        {
          "kind": "implementation-quirk",
          "text": "Logical border edges are mapped as `horizontal-tb` LTR."
        }
      ]
    }
  ]
}
