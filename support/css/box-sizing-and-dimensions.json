{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "box-sizing-and-dimensions",
  "title": "Box sizing and dimensions",
  "subjects": {
    "properties": [
      "box-sizing",
      "width",
      "height",
      "inline-size",
      "block-size",
      "min-width",
      "min-height",
      "min-inline-size",
      "min-block-size",
      "max-width",
      "max-height",
      "max-inline-size",
      "max-block-size",
      "aspect-ratio"
    ],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "box-sizing",
      "description": "Content-box and border-box sizing determine how authored dimensions include padding and borders.",
      "properties": [
        "box-sizing"
      ],
      "syntax": [
        "content-box",
        "border-box"
      ],
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": [
          "box-sizing-min-max-size-constraints"
        ]
      },
      "notes": []
    },
    {
      "id": "preferred-dimensions",
      "description": "Physical and logical preferred dimensions resolve supported fixed and percentage sizes.",
      "properties": [
        "width",
        "height",
        "inline-size",
        "block-size"
      ],
      "syntax": [
        "<px>",
        "<percentage>",
        "<em>",
        "<rem>",
        "<viewport-length>",
        "calc(<length-expression>)",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "offset-geometry",
          "percentage-sizing",
          "calculated-relative-lengths"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Calculations must reduce to either a pixel length or a percentage. Mixed percentage-and-length calculations remain unsupported by the Taffy dimension model."
        }
      ]
    },
    {
      "id": "minimum-and-maximum-dimensions",
      "description": "Physical and logical minimum and maximum constraints bound computed sizes.",
      "properties": [
        "min-width",
        "min-height",
        "min-inline-size",
        "min-block-size",
        "max-width",
        "max-height",
        "max-inline-size",
        "max-block-size"
      ],
      "syntax": [
        "<px>",
        "<percentage>",
        "<em>",
        "<rem>",
        "<viewport-length>",
        "calc(<length-expression>)",
        "auto",
        "none"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "box-sizing-min-max-size-constraints",
          "min-max-size-constraints",
          "calculated-relative-lengths"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Calculations must reduce to either a pixel length or a percentage. Mixed percentage-and-length calculations remain unsupported by the Taffy dimension model."
        }
      ]
    },
    {
      "id": "aspect-ratio",
      "description": "Preferred aspect ratios affect either axis and interact with supported size constraints.",
      "properties": [
        "aspect-ratio"
      ],
      "syntax": [
        "auto",
        "<number>",
        "<ratio>"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "aspect-ratio"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Complex intrinsic sizing interactions outside the supported dimension subset are not modeled."
        }
      ]
    }
  ]
}
