{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "display",
  "title": "Display model",
  "subjects": {
    "properties": ["display"],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "block-and-inline-aliases",
      "description": "Block flow and supported inline display aliases produce deterministic layout boxes.",
      "properties": ["display"],
      "syntax": ["block", "inline", "inline-block", "flow-root", "list-item"],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": ["display-aliases", "static-block-flow"]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "Authored `inline`, `inline-block`, `flow-root`, and `list-item` values are blockified."
        },
        {
          "kind": "limitation",
          "text": "Inline formatting and list marker layout are not modeled."
        }
      ]
    },
    {
      "id": "flex-and-grid-containers",
      "description": "Flex and grid display values select the corresponding layout model.",
      "properties": ["display"],
      "syntax": ["flex", "inline-flex", "grid", "inline-grid"],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": ["flex-row", "grid-explicit-tracks"]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "`inline-flex` and `inline-grid` are mapped to `flex` and `grid`; their inline-level outer display behavior is not modeled."
        }
      ]
    },
    {
      "id": "box-generation",
      "description": "Box suppression and child flattening follow supported display semantics.",
      "properties": ["display"],
      "syntax": ["contents", "none"],
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": ["display-contents", "display-none"]
      },
      "notes": [
        {
          "kind": "browser-parity",
          "text": "`display: contents` has parity coverage for parent box removal plus block and flex child flattening."
        }
      ]
    }
  ]
}
