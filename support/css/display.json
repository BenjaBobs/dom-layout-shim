{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "display",
  "title": "Display model",
  "subjects": {
    "properties": [
      "display"
    ],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "current-supported-scope",
      "syntax": [
        "block",
        "inline",
        "inline-block",
        "flow-root",
        "list-item",
        "flex",
        "inline-flex",
        "grid",
        "inline-grid",
        "contents",
        "none"
      ],
      "support": "partial",
      "parity": {
        "status": "partially-verified",
        "fixtures": [
          "display-aliases",
          "display-contents",
          "display-none",
          "static-block-flow",
          "flex-row",
          "grid-explicit-tracks"
        ]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "Authored inline, inline-block, flow-root, and list-item are blockified; inline-flex and inline-grid are mapped to flex and grid."
        },
        {
          "kind": "limitation",
          "text": "Inline formatting and list marker layout are not modeled."
        },
        {
          "kind": "browser-parity",
          "text": "display: contents has parity coverage for parent box removal plus block and flex child flattening."
        }
      ]
    }
  ]
}
