{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "grid-layout",
  "title": "Grid layout",
  "subjects": {
    "properties": [
      "grid-template-columns",
      "grid-template-rows",
      "grid-auto-flow",
      "grid-auto-columns",
      "grid-auto-rows",
      "grid-column",
      "grid-row",
      "grid-column-start",
      "grid-column-end",
      "grid-row-start",
      "grid-row-end",
      "grid-area"
    ],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "explicit-tracks",
      "description": "Explicit row and column tracks support fixed, percentage, fractional, minimum/maximum, and repeated sizing.",
      "properties": [
        "grid-template-columns",
        "grid-template-rows"
      ],
      "syntax": [
        "none",
        "<px>",
        "<percentage>",
        "<fr>",
        "minmax(<track-breadth>, <track-breadth>)",
        "repeat(<integer>, <track-list>)"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "grid-explicit-tracks",
          "grid-fr-tracks",
          "grid-minmax-tracks",
          "grid-percentage-tracks",
          "grid-repeat-tracks"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "`auto-fill` and `auto-fit` repeat counts, named lines, `fit-content()`, named grid areas, and `grid-template-areas` are not implemented."
        },
        {
          "kind": "limitation",
          "text": "`repeat()` supports positive integer counts with the already-supported track breadth values inside the repeated track list."
        },
        {
          "kind": "taffy-compat",
          "text": "Explicit `minmax()` row caps can diverge from Chromium in Taffy 0.9.2."
        },
        {
          "kind": "taffy-compat",
          "text": "Flexible `fr` tracks are mapped to Taffy min/max tracks with minimum zero and maximum `Nfr` because Taffy accepts `fr` only as a maximum track sizing function."
        }
      ]
    },
    {
      "id": "implicit-tracks-and-auto-flow",
      "description": "Auto-placement creates implicit tracks using configured row and column sizing.",
      "properties": [
        "grid-auto-flow",
        "grid-auto-columns",
        "grid-auto-rows"
      ],
      "syntax": [
        "row",
        "column",
        "dense",
        "auto",
        "<px>",
        "<percentage>",
        "<fr>",
        "minmax(<track-breadth>, <track-breadth>)"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "grid-auto-flow",
          "grid-auto-tracks"
        ]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "Auto-height grids with empty implicit `minmax()` rows can diverge from Chromium in Taffy 0.9.2; parity coverage therefore uses a definite grid height."
        }
      ]
    },
    {
      "id": "line-and-span-placement",
      "description": "Grid items can use numeric lines and numeric spans on either axis.",
      "properties": [
        "grid-column",
        "grid-row",
        "grid-column-start",
        "grid-column-end",
        "grid-row-start",
        "grid-row-end"
      ],
      "syntax": [
        "auto",
        "<integer>",
        "span <integer>"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "grid-line-placement",
          "grid-span-placement"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Named lines and named spans are not implemented."
        }
      ]
    },
    {
      "id": "area-shorthand-placement",
      "description": "The `grid-area` shorthand maps supported numeric row and column placements.",
      "properties": [
        "grid-area"
      ],
      "syntax": [
        "auto",
        "<integer>",
        "span <integer>"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "grid-area-placement"
        ]
      },
      "notes": [
        {
          "kind": "limitation",
          "text": "Named grid areas and `grid-template-areas` are not implemented."
        }
      ]
    },
    {
      "id": "shared-grid-placement-behavior",
      "description": "Shared gap, alignment, stretching, and order behavior participates in grid placement.",
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": [
          "grid-content-alignment",
          "grid-gap",
          "grid-item-stretch",
          "grid-order"
        ]
      },
      "notes": [
        {
          "kind": "implementation-quirk",
          "text": "The CSS `order` property is applied by sorting grid children before building the Taffy tree, so auto-placement sees order-modified children."
        }
      ]
    }
  ]
}
