{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "hit-testing",
  "title": "Hit testing visibility and overflow",
  "subjects": {
    "properties": [
      "pointer-events",
      "visibility",
      "overflow",
      "overflow-x",
      "overflow-y"
    ],
    "elements": []
  },
  "effect": "hit-testing",
  "owner": "hit-testing",
  "claims": [
    {
      "id": "point-query-ordering",
      "description": "Point queries return the frontmost eligible box and preserve front-to-back ordering.",
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": [
          "center-click-blocked-by-overlay",
          "elements-from-point-order"
        ]
      },
      "notes": []
    },
    {
      "id": "pointer-event-participation",
      "description": "`pointer-events` controls whether boxes and descendants participate in point queries.",
      "properties": ["pointer-events"],
      "syntax": ["auto", "none"],
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": ["pointer-events-none"]
      },
      "notes": []
    },
    {
      "id": "visibility-participation",
      "description": "`visibility` controls point-query participation while retaining layout boxes.",
      "properties": ["visibility"],
      "syntax": ["visible", "hidden", "collapse"],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": ["visibility-hidden"]
      },
      "notes": [
        {
          "kind": "implementation-quirk",
          "text": "`visibility: collapse` is treated as `hidden` for DOM-like box hit testing; table row and column collapse layout is not modeled."
        }
      ]
    },
    {
      "id": "overflow-clipping",
      "description": "Overflow modes clip descendant hit boxes to the padding box.",
      "properties": ["overflow", "overflow-x", "overflow-y"],
      "syntax": ["visible", "hidden", "clip", "auto", "scroll"],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": ["overflow-clipping"]
      },
      "notes": [
        {
          "kind": "behavior-quirk",
          "text": "`hidden`, `clip`, `auto`, and `scroll` clip descendant hit boxes to the padding box; `getBoundingClientRect()` output is not clipped."
        }
      ]
    },
    {
      "id": "scroll-offsets-and-visibility",
      "description": "Element and viewport scrolling offset geometry and update point-query visibility.",
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": [
          "element-scroll-offsets",
          "scroll-into-view",
          "window-scroll-offsets"
        ]
      },
      "notes": []
    }
  ]
}
