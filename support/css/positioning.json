{
  "$schema": "../css-support.schema.json",
  "schemaVersion": 1,
  "id": "positioning",
  "title": "Positioning and insets",
  "subjects": {
    "properties": [
      "position",
      "left",
      "right",
      "top",
      "bottom",
      "inset",
      "inset-inline",
      "inset-block",
      "inset-inline-start",
      "inset-inline-end",
      "inset-block-start",
      "inset-block-end",
      "z-index"
    ],
    "elements": []
  },
  "effect": "layout",
  "owner": "taffy-adapter",
  "claims": [
    {
      "id": "normal-flow-positioning",
      "description": "`position: static` retains normal-flow placement and resets supported positioned behavior.",
      "properties": [
        "position"
      ],
      "syntax": [
        "static"
      ],
      "support": "supported",
      "parity": {
        "status": "verified",
        "fixtures": [
          "static-block-flow"
        ]
      },
      "notes": []
    },
    {
      "id": "relative-positioning",
      "description": "Relative offsets move boxes without removing their normal-flow space.",
      "properties": [
        "position",
        "left",
        "right",
        "top",
        "bottom",
        "inset",
        "inset-inline",
        "inset-block",
        "inset-inline-start",
        "inset-inline-end",
        "inset-block-start",
        "inset-block-end"
      ],
      "syntax": [
        "relative",
        "<px>",
        "<percentage>",
        "<em>",
        "<rem>",
        "<viewport-length>",
        "calc(<length-expression>)",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "inset-two-value-shorthand",
          "relative-offset-flow",
          "right-bottom-positioning"
        ]
      },
      "notes": []
    },
    {
      "id": "absolute-positioning",
      "description": "Absolute boxes resolve supported insets against their containing block.",
      "properties": [
        "position",
        "left",
        "right",
        "top",
        "bottom",
        "inset",
        "inset-inline",
        "inset-block",
        "inset-inline-start",
        "inset-inline-end",
        "inset-block-start",
        "inset-block-end"
      ],
      "syntax": [
        "absolute",
        "<px>",
        "<percentage>",
        "<em>",
        "<rem>",
        "<viewport-length>",
        "calc(<length-expression>)",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "absolute-overlap",
          "absolute-positioned-containing-block",
          "inset-two-value-shorthand",
          "right-bottom-positioning"
        ]
      },
      "notes": []
    },
    {
      "id": "fixed-positioning",
      "description": "Fixed boxes resolve against the configured viewport and ignore ancestor scrolling.",
      "properties": [
        "position",
        "left",
        "right",
        "top",
        "bottom",
        "inset",
        "inset-inline",
        "inset-block",
        "inset-inline-start",
        "inset-inline-end",
        "inset-block-start",
        "inset-block-end"
      ],
      "syntax": [
        "fixed",
        "<px>",
        "<percentage>",
        "<em>",
        "<rem>",
        "<viewport-length>",
        "calc(<length-expression>)",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "fixed-inside-scrolled-ancestor",
          "fixed-inset-full-viewport"
        ]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "Fixed positioning is represented through Taffy absolute positioning in the viewport-rooted layout tree."
        }
      ]
    },
    {
      "id": "sticky-positioning",
      "description": "Sticky boxes remain in flow and are constrained by supported physical insets and scrollports.",
      "properties": [
        "position",
        "left",
        "right",
        "top",
        "bottom"
      ],
      "syntax": [
        "sticky",
        "<px>",
        "auto"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "sticky-positioning"
        ]
      },
      "notes": [
        {
          "kind": "taffy-compat",
          "text": "Taffy does not implement sticky positioning, so sticky boxes remain in Taffy normal flow and are constrained against their supported scrollport during geometry collection."
        }
      ]
    },
    {
      "id": "stacking-order",
      "description": "Nested positioned stacking contexts, integer `z-index` values, and DOM order determine supported point-query stacking.",
      "properties": [
        "z-index"
      ],
      "syntax": [
        "auto",
        "<integer>"
      ],
      "support": "partial",
      "parity": {
        "status": "verified",
        "fixtures": [
          "elements-from-point-order",
          "z-index-dom-order"
        ]
      },
      "notes": [
        {
          "kind": "browser-parity",
          "text": "Parity covers nested positioned contexts, containment of high-z-index descendants, integer `z-index` values, and DOM-order fallback."
        },
        {
          "kind": "limitation",
          "text": "Stacking contexts created by opacity, filters, blending, isolation, containment, and other visual-only triggers remain outside the modeled subset."
        }
      ]
    }
  ]
}
