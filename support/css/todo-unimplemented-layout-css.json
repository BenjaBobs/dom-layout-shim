    {
      "id": "advanced-table-layout",
      "description": "Advanced table border and empty-cell behavior remains incomplete.",
      "properties": ["border-collapse", "border-spacing", "empty-cells"],
      "support": "unsupported",
      "parity": {
        "status": "unverified",
        "fixtures": []
      },
      "notes": [
