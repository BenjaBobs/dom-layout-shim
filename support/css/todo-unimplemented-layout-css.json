      "parity": {
        "status": "unverified",
        "fixtures": []
      },
      "notes": [
        {
          "kind": "todo",
          "text": "These declarations are likely to matter for layout coherence but are not accepted as implemented behavior."
        }
      ]
    },
    {
      "id": "floats-and-clearance",
      "description": "Floated layout and clearance are tracked but unsupported.",
      "properties": [
        "float: left/right/inline-start/inline-end",
        "clear: left/right/both/inline-start/inline-end"
      ],
      "support": "unsupported",
      "parity": {
        "status": "unverified",
        "fixtures": []
      },
      "notes": [
        {
          "kind": "todo",
          "text": "Float placement and clearance are not implemented."
        }
      ]
    },
    {
      "id": "inline-and-list-formatting",
      "description": "Inline formatting contexts and list markers are tracked but unsupported.",
      "properties": [
        "display: inline formatting",
        "display: list-item markers"
      ],
      "support": "unsupported",
      "parity": {
        "status": "unverified",
        "fixtures": []
      },
      "notes": [
        {
          "kind": "todo",
          "text": "Inline fragment layout and list marker boxes are not implemented."
