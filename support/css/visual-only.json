      "object-position"
    ],
    "elements": []
  },
  "effect": "visual-ignored",
  "owner": "css-parser",
  "claims": [
    {
      "id": "current-supported-scope",
      "support": "partial",
      "parity": {
        "status": "partially-verified",
        "fixtures": [
          "visual-only-properties"
        ]
      },
      "notes": [
        {
          "kind": "browser-parity",
          "text": "Accepted visual-only declarations have parity coverage that they do not affect rectangles or point queries under this package contract."
        },
        {
          "kind": "limitation",
          "text": "Painting, decoration rendering, and visual overflow are not modeled."
        }
      ]
    }
  ]
}
